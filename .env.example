# Copy this file to .env and fill in whichever keys you have.
# .env is git-ignored — never commit real keys.
# Everything here is optional; SolPulse runs with zero keys and degrades
# gracefully, flagging each missing source in the report.


# X / Twitter API v2 bearer token
TWITTER_BEARER_TOKEN=

# Glassnode — https://studio.glassnode.com/settings/api
# Used for daily active addresses (SOL is supported).
GLASSNODE_API_KEY=

# CoinMarketCap — https://pro.coinmarketcap.com/account
# Optional cross-check/fallback if CoinGecko rate-limits you.
CMC_API_KEY=

# Optional overrides
# SOLPULSE_RPC_URL=https://api.mainnet-beta.solana.com
# SOLPULSE_INTERVAL=300
